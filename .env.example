# Copy this file to .env and fill in the placeholders.

# Tableau Cloud pod URL（例: https://prod-useast-c.online.tableau.com）
# 自テナントの管理画面 URL から pod 部分を控える
TABLEAU_SERVER=https://<pod>.online.tableau.com

# Content URL（display name ではなく URL の方）
TABLEAU_SITE_NAME=<your-content-url-here>

# ローカル callback listener のポート（loopback 必須）
LOCAL_CALLBACK_PORT=8765
